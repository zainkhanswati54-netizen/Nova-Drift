# Platform folders - now committed on purpose so the Impeller-disable
# patch in android/app/src/main/AndroidManifest.xml survives instead of
# being wiped out every time `flutter create` regenerates this folder.
# See: https://github.com/flutter/flutter/issues/176272
# ios/ still generated fresh - no iOS-specific patch needed.
ios/

